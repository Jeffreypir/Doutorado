function! CriandoArquivo()
	let l:filename = input("Enter filename: ")
	execute 'silent! 250vsp ' . b:netrw_curdir.'/'.l:filename
	redraw!
endf


autocmd filetype netrw call ChameArquivo()
autocmd filetype netrw call ChamaArquivo()

function! ChamaArquivo()
	noremap <buffer><F3> :call CriandoArquivo()<cr>
endfunction

function! ChameArquivo()
	noremap <buffer>% :call CriandoArquivo()<cr>
endfunction

nnoremap <C-q> :q!<CR>
map <leader>nt :Ntree<cr>
